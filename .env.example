# Application
ENVIRONMENT=development
EXPOSE_DEVELOPMENT_OTP=false
DEBUG=true
HOST=127.0.0.1
PORT=8000
SECRET_KEY=replace-with-a-long-random-local-secret

# MongoDB
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=cyberaware

# Groq AI
GROQ_API_KEY=
GROQ_MODEL=
YOUTUBE_API_KEY=

# SMTP
MAIL_SERVER=localhost
MAIL_PORT=587
MAIL_USERNAME=local-placeholder
MAIL_PASSWORD=local-placeholder
MAIL_FROM=noreply@example.com
MAIL_STARTTLS=true
MAIL_SSL_TLS=false

# Optional frontend API override for non-proxied deployments
# VITE_API_URL=http://localhost:8000/api/v1
